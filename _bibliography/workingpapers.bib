@article{lattmann2024sentiment,
  abbr={Working Paper},
  title={How EU place-based policies shape discourse on the EU: Analysis of
communication by political candidates (R\&R)},
  author={Lattmann, Johannes},
  abstract={This article explores the relationship between the reception of EU (European
Union) place-based policies and political candidates’ political communication about
the EU. While it is often assumed that recipients of EU funding adopt more favor-
able views, I argue that such support potentially reinforces euroskeptic narratives.
In particular, euroskeptic parties leverage the visibility and politicization of EU
funding to amplify their opposition to the EU. Drawing on a comprehensive social
media dataset from German election candidates’ posts between 2014 and 2021 (N =
4.482.601), this study examines how regional EU funding is associated with candi-
dates’ stances and the prominence of EU-related content in their communications.
To assess levels of euroskepticism, I develop a transformer-based supervised clas-
sification model capable of detecting a variety of political stances toward the EU.
I find that EU funding is associated with higher levels of EU politicization among
political candidates, but only in eastern Germany. Also, across all specifications
my results suggest that EU funding is positively associated with more eurosceptic
posts for candidates from the Alternative for Germany (AfD), drawing a pessimistic
imagine of EU funding as a possible solution to moderate eurosceptic parties.},
  publisher={R\&R},
  preview={salience.png},
  year={}
}


@article{lattmann2024EUfalsepromise,
  abbr={Working Paper},
  title={A False Promise for the Left Behind: The Uneven Political Impact of EU Place-Based Policies (In Review, preprint available)},
  author={Lattmann, Johannes and Lang, Valentin},
  abstract={To counter regionally concentrated political frustration, place-based economic policies targeting disadvantaged regions have become increasingly popular among policymakers. This paper examines the effectiveness of place-based policies in mitigating political frustration and populism with a focus on their distributional effects within regions. We argue that place-based policies are unlikely to benefit the most disadvantaged voters due to a skill bias. Empirically, we study the world's largest place-based policy in the context of the European Union (EU) using a natural experiment and randomized survey experiments. We construct a 1980-2020 dataset with subnational geocodes at the individual level (N=1.4 million) across the EU and leverage a discontinuity in regional funding eligibility in an RD design. In experiments embedded in a two-wave survey (N=2,046), we expose respondents to information and encouragement treatments related to the policy. Both analyses show that place-based policies reduce political discontent only among the highly skilled and the rich, while political attitudes of other groups are not affected. These results highlight that the effectiveness of place-based policies in addressing political discontent is severely limited by their distributional effects.},
  publisher={In Review, preprint available},
  pdf={https://osf.io/preprints/socarxiv/pn8dm_v1},
  preview={eu_support_descriptive.png},
  year={}
}


@article{ineligible,
  abbr={Working Paper},
  title={Misperception about Campaign Cost and Candidate
Entry: Evidence from French Elections},
  author={Stupperich, Johannes and Lattmann, Johannes},
  publisher={Preparing submission},
  abstract={Do candidates misperceive campaign cost when they decide to stand for elec-
tion? To answer this question we differentiate conceptually between ex-ante and
ex-post cost and apply this framework to French legislative elections. Ex-ante
costs need to be paid before candidates stand, whereas ex-post cost are due af-
ter the campaign and thus can be misperceived at the time of running. One such
ex-post cost — the requirement to file a campaign account which results in inel-
igibility in case of non-compliance — only affects French candidates who gained
more than 1% of the vote share. We exploit this discontinuity and estimate that
at the threshold at least 7.4% of candidates under-estimate this type of campaign
cost related to administrative hurdles. In contrast, the sanctioning probability falls
by 2.8 percentage points at the more salient 5% threshold advertised clearly by the
government. Consistent with our misperception theory, sanctioned candidates are
on average less experienced and less likely to be supported by a party than their
non-sanctioned counterparts. Before a 2011 reform, which extended ineligibility to
any kind of elections, sanctioned candidates were more likely to subsequently con-
test local elections. While previous literature suggests that politicians misperceive
constituency preferences, we show that beyond that, some candidates misperceive
the “rules” of electoral competition. We conclude with implications for the number
of candidates and a discussion of the relevance of small candidates for electoral
competition.},
  preview={candidates_france.png},
  year={}
}

@article{immigrationsupport,
  abbr={Working Paper},
  title={Immigration and support for redistribution},
  author={Lattmann, Johannes, Schmidt-Catran, Alex and Garritzmann, Julian},
  publisher={Preparing submission},
  abstract={Immigration shapes public support for redistribution. Recent debates on this matter underline
that information on or the perception of migration can shape redistribution preferences, but
often remains silent about the complexity of the underlying mechanisms. This article focuses
on the theoretical channels responsible for this relationship. We argue that for high socioeconomic citizens it is not economic threat that determines changes in redistribution preferences
but predominantly cultural threat perceptions. For citizens with lower socio-economic status,
we argue it is particularly economic threat that drives support for redistribution. We test this
argument by examining European Social Survey data from 31 countries (N = 450.000) from
2002-2023. To account for potential endogeneity, we reiterate our analysis panel data from the
British Election Study (N = 340.000). Our results support our argument, indicating that citizens
with high-skilled occupations, high education and high income show significantly stronger
associations between cultural migration threat and redistribution support, while they tend to
show significantly weaker associations with economic threat perceptions. For citizens with low
socio-economic status, both economic and cultural threat perceptions matter for redistribution
preferences. Country heterogeneity in this relationship underlines the complexity of the
relationship.},
  preview={immigration_threat.png},
  year={}
}

@article{euwhat,
  abbr={Working Paper},
  title={What Citizens Want from Europe: Ideology, Territory, and Support for EU Action across Policy Domains},
  author={Lattmann, Johannes and Schramm, Lucas},
  publisher={Preparing submission},
  abstract={What do citizens want from Europe? Research on public opinion has moved beyond a binary of pro- and anti-EU attitudes, yet we know little about how the two classic lines of conflict in European politics – ideology and territory   – compare when citizens are asked where the European Union (EU) should do more. This paper juxtaposes a functional (left–right) and a territorial (national and macro-regional) cleavage and examines their relative weight across twelve policy domains. Using Solidarity in Europe trend data covering around 100.000 respondents from 21 member states between 2020 and 2025 , we show, first, that the association between ideology and support for EU action differs significantly across regions and countries in every domain. Second, first-difference estimates reveal that neither ideology nor territory consistently structures contestation. Territorial differences prevail in redistributive domains such as pensions and unemployment, whereas ideological differences dominate in environment and climate policy and on immigration. We conclude that conflict over Europe is domain-specific: which cleavage matters depends on what the EU is asked to do.},
  preview={what_europe.png},
  year={}
}

@article{lattmann2024euheterogeneity,
  abbr={Working Paper},
  title={Heterogeneity in the Political and Economic Effect of EU Place-Based Policy Schemes: A Supply-Side Analysis in German Municipalities},
  author={Lattmann, Johannes},
  publisher={In analysis},
  abstract={Place-based policies are often depicted as a means of decreasing resentment by improving economic conditions in left-behind places. Yet, little attention had been paid to the heterogeneity of funds and their respective ends. Relying on 335,000 projects by the European Cohesion Policy for the funding period 2014-2020 in Germany, I investigate how different funding types impact the vote share for the eurosceptic party AfD and support for the EU. First, for the electoral analysis, I use a fine-grained municipality level-dataset (n = 48,045). Second, to further investigate the mechanism of my argument, I harmonized two GLES election datasets (n = 12,000) for examining individual-level data. I find that public good projects and direct firm support are especially potent in improving firm tax revenues. Nevertheless, it is projects dedicated to individual support or public goods that significantly decrease AfD vote share. Lastly, I show that the effect on project type on EU support is depending on the income-level of citizens.},
  preview={tax.png},
  year={}
}

